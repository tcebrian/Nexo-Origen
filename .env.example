# Supabase (obligatorio)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role (solo servidor). Necesaria para leer datos (resenas, kpi, etc.) sin depender de RLS.
# Sin esta clave el dashboard puede quedar vacío aunque el login funcione.
# Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Fase 2 — Filtrar datos por empresa/marca/restaurante según rol del usuario
NEXT_PUBLIC_DATA_SCOPING_ENABLED=false

# WhatsApp (aviso automático de reseñas negativas vía Twilio)
# Twilio Console → Account → API keys & tokens
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de WhatsApp de Twilio, formato "whatsapp:+14155238886" (el del sandbox mientras se prueba)
TWILIO_WHATSAPP_FROM=
# Secreto compartido para verificar que las llamadas al webhook vienen de Supabase (invéntate una cadena larga)
WHATSAPP_WEBHOOK_SECRET=


# Resúmenes diarios de agentes
# Preferido: webhook de Make conectado al WhatsApp Business actual.
MAKE_DAILY_SUMMARY_WEBHOOK_URL=
# Opcional: secreto compartido Nexo → Make.
MAKE_DAILY_SUMMARY_WEBHOOK_SECRET=
# Vercel Cron añade este secreto como Authorization Bearer cuando está configurado.
CRON_SECRET=

# Nexo Conversations — WhatsApp Cloud API oficial de Meta (sin Twilio ni Make).
# Solo servidor. Token que Nexo y Meta acuerdan al registrar el webhook (GET de verificación).
WHATSAPP_CLOUD_VERIFY_TOKEN=
# App Secret de la app de Meta: verifica la firma X-Hub-Signature-256 de cada evento (POST).
WHATSAPP_CLOUD_APP_SECRET=

# Nexo Conversations — envío saliente. Token de acceso permanente/de sistema de la app de Meta
# con permiso whatsapp_business_messaging. Solo servidor; distinto de APP_SECRET y VERIFY_TOKEN.
WHATSAPP_CLOUD_ACCESS_TOKEN=

# Credencial interna de renderizado (solo servidor). El Chromium de Nexo la envía en la
# cabecera X-Nexo-Internal-Render-Token para abrir /templates/network-summary/...; sin ella
# (o con menos de 16 caracteres) esa plantilla solo la ve un super_admin con sesión.
# Genérala con: openssl rand -hex 32
NEXO_INTERNAL_RENDER_TOKEN=
