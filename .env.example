# Supabase (obligatorio)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role (solo servidor). Necesaria para leer datos (resenas, kpi, etc.) sin depender de RLS.
# Sin esta clave el dashboard puede quedar vacío aunque el login funcione.
# Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Fase 1 — Login + roles en menú/rutas (obligatorio en producción)
NEXT_PUBLIC_AUTH_ENABLED=true

# Fase 2 — Filtrar datos por empresa/marca/restaurante según rol del usuario
NEXT_PUBLIC_DATA_SCOPING_ENABLED=false
